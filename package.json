{
  "name": "@moonstar-x/tsconfig",
  "version": "1.0.0",
  "description": "Maximally strict, pedantic TypeScript configurations for TypeScript — a base config plus Node and React variants.",
  "type": "module",
  "exports": {
    ".": "./base.json",
    "./base": "./base.json",
    "./base.json": "./base.json",
    "./node": "./node.json",
    "./node.json": "./node.json",
    "./react": "./react.json",
    "./react.json": "./react.json",
    "./package.json": "./package.json"
  },
  "files": [
    "base.json",
    "node.json",
    "react.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "tsconfig",
    "typescript",
    "strict",
    "strictest",
    "config",
    "react",
    "node"
  ],
  "license": "MIT",
  "author": "moonstar-x <christian.lopez99@outlook.com>",
  "homepage": "https://github.com/moonstar-x-libs/tsconfig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonstar-x-libs/tsconfig.git"
  },
  "bugs": {
    "url": "https://github.com/moonstar-x-libs/tsconfig/issues"
  },
  "peerDependencies": {
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": false
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
